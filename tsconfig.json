{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"lib": ["dom", "es2022"],
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		],
		"paths": {
			"@mariomh/navigation-menu/astro/*": ["./node_modules/@mariomh/navigation-menu/dist/astro/*.astro"],
			"@mariomh/navigation-menu/astro": ["./node_modules/@mariomh/navigation-menu/dist/astro/menu.astro"],
			"@mariomh/*/astro": ["./node_modules/@mariomh/*/dist/component.astro"]
		}
	},
	"include": ["www/src", "www/astro.config.ts", "www/.astro", "functions/vite.config.ts", "functions/src"],
	"exclude": ["node_modules", "dist", "www/public"]
}
