{
	"extends": "@hexadrop/tsconfig",
	"compilerOptions": {
		"emitDecoratorMetadata": false,
		"paths": {
			"@assets/*": ["./src/assets/*"],
			"@features/*": ["./src/features/*"],
			"@layout": ["./src/layouts/layout.astro"]
		},
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		]
	},
	"exclude": ["dist", ".astro", "node_modules"]
}
