{
	"extends": "@hexadrop/tsconfig",
	"compilerOptions": {
		"emitDecoratorMetadata": false,
		"baseUrl": ".",
		"paths": {
			"@mariomh/desing-system/cva": ["design-system/lib/cva.ts"],
			"@mariomh/desing-system/components/focus/*": ["design-system/components/focus/*.ts"],
			"@mariomh/desing-system/components/font/*": ["design-system/components/font/*.ts"],
			"@mariomh/desing-system/components/link/*": ["design-system/components/link/*.ts"],
			"@mariomh/desing-system/components/round/*": ["design-system/components/round/*.ts"],
			"@mariomh/desing-system/fonts/archia": ["design-system/fonts/archia/index.css"],
			"@mariomh/desing-system/fonts/archia/*": ["design-system/fonts/archia/*"],
			"@mariomh/desing-system/tailwind": ["design-system/tailwind/index.css"]
		},
		"allowImportingTsExtensions": true,
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		]
	},
	"exclude": [
		"design-system/dist"
	]
}
