<style is:global>
	:root {
		--font-family-primary: Archia, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
		--font-family-secondary: DMSans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";

		--font-weight-base: 200;

		--size-2xs: clamp(0.45rem, -0.05vw + 0.46rem, 0.42rem);
		--size-xs: clamp(0.56rem, 0.01vw + 0.56rem, 0.56rem);
		--size-sm: clamp(0.7rem, 0.09vw + 0.68rem, 0.75rem);
		--size-base: clamp(0.88rem, 0.23vw + 0.82rem, 1rem);
		--size-lg: clamp(1.09rem, 0.43vw + 0.98rem, 1.33rem);
		--size-xl: clamp(1.37rem, 0.74vw + 1.18rem, 1.78rem);
		--size-2xl: clamp(1.71rem, 1.2vw + 1.41rem, 2.37rem);
		--size-3xl: clamp(2.14rem, 1.86vw + 1.67rem, 3.16rem);
		--size-4xl: clamp(2.67rem, 2.8vw + 1.97rem, 4.21rem);

		--color-primary-100: #FDFFF5;
		--color-primary-200: #EEFFA9;
		--color-primary-300: #C6F118;
		--color-primary-300-80: rgba(198, 241, 24, 0.8);
		--color-primary-400: #83AC2A;
		--color-primary-500: #002E26;
		--color-primary-600: #001B16;


		--color-background: var(--color-primary-100);
		--color-foreground: var(--color-primary-600);
		--color-foreground-shadow: 2px 2px 15px 0 rgb(0, 27, 22);
		--color-foreground-card: var(--color-primary-100);
		--color-background-card: var(--color-primary-500);
        --color-scroll-handle: var(--color-primary-500);
        --color-scroll-handle-hover: var(--color-primary-600);
	}

	/* @media (prefers-color-scheme: dark) {

        :root {
			--color-background: var(--color-primary-600);
			--color-foreground: var(--color-primary-100);
			--color-background-card: var(--color-primary-100);
			--color-foreground-card: var(--color-primary-600);
		}
	}*/

    body {
        background-color: var(--color-background);
        font-weight: var(--font-weight-base);
        font-size: var(--size-base);
        font-family: var(--font-family-primary);
        color: var(--color-foreground);

        -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }



	h6 {
		font-size: var(--size-sm)
	}

	h5 {
		font-size: var(--size-base)
	}

	h4 {
		font-size: var(--size-lg)
	}

	h3 {
		font-size: var(--size-xl)
	}

	h2 {
		font-size: var(--size-2xl)
	}

	h1 {
		font-size: var(--size-3xl)
	}

</style>
