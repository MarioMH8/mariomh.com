<style is:global>
	:root {
		--font-family-primary: Archia, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
		--font-family-secondary: DMSans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";

		--font-weight-thin: 100;
		--font-weight-extra-light: 200;
		--font-weight-light: 300;
		--font-weight-normal: 400;
		--font-weight-medium: 500;
		--font-weight-semi-bold: 600;
		--font-weight-bold: 700;
		--font-weight-extra-bold: 800;
		--font-weight-heavy: 900;

		--size-2xs: clamp(0.45rem, -0.05vw + 0.46rem, 0.42rem);
		--size-xs: clamp(0.56rem, 0.01vw + 0.56rem, 0.56rem);
		--size-sm: clamp(0.7rem, 0.09vw + 0.68rem, 0.75rem);
		--size-base: clamp(0.88rem, 0.23vw + 0.82rem, 1rem);
		--size-lg: clamp(1.09rem, 0.43vw + 0.98rem, 1.33rem);
		--size-xl: clamp(1.37rem, 0.74vw + 1.18rem, 1.78rem);
		--size-2xl: clamp(1.71rem, 1.2vw + 1.41rem, 2.37rem);
		--size-3xl: clamp(2.14rem, 1.86vw + 1.67rem, 3.16rem);
		--size-4xl: clamp(2.67rem, 2.8vw + 1.97rem, 4.21rem);

		--size-container: 1400px;

		--color-primary-100: #FDFFF5;
		--color-primary-200: #EEFFA9;
		--color-primary-300: #C6F118;
		--color-primary-300-80: rgba(198, 241, 24, 0.8);
		--color-primary-400: #83AC2A;
		--color-primary-500: #002E26;
		--color-primary-600: #001B16;


		--color-background: var(--color-primary-100);
		--color-foreground: var(--color-primary-500);
		--color-foreground-secondary: var(--color-primary-400);
		--color-foreground-shadow: 2px 2px 15px 0 rgb(0, 27, 22);
		--color-scroll-handle: var(--color-primary-300);
		--color-scroll-handle-hover: var(--color-primary-400);
	}

	@media (prefers-color-scheme: dark) {

		:root {
			--color-background: var(--color-primary-600);
			--color-foreground: var(--color-primary-100);
			--color-foreground-secondary: var(--color-primary-300);
		}
	}

	body {
		background-color: var(--color-background);
		color: var(--color-foreground);

		font-weight: var(--font-weight-normal);
		font-size: var(--size-base);
		font-family: var(--font-family-primary);

		-webkit-tap-highlight-color: rgba(0, 0, 0, 0);
		-webkit-touch-callout: none;
		-webkit-user-select: none;
		-moz-user-select: none;
		-ms-user-select: none;
		user-select: none;
	}

	body:has(dialog[open]) {
		overflow-y: hidden;
	}

	img {
		user-drag: none;
		-webkit-user-drag: none;
		user-select: none;
		-moz-user-select: none;
		-webkit-user-select: none;
		-ms-user-select: none;
	}

	/* Headings */
	h1,h2,h3,h4,h5,h6 {
		display: block;
	}

	/* Font size */
	h6,
	.text-sm {
		font-size: var(--size-sm)
	}

	h5,
	.text-base {
		font-size: var(--size-base)
	}

	h4,
	.text-lg {
		font-size: var(--size-lg)
	}

	h3,
	.text-xl {
		font-size: var(--size-xl)
	}

	h2,
	.text-2xl {
		font-size: var(--size-2xl)
	}

	h1,
	.text-3xl {
		font-size: var(--size-3xl)
	}

	.text-4xl {
		font-size: var(--size-4xl)
	}

	/* Font weight */
	.font-thin {
		font-weight: var(--font-weight-thin);
	}

	.font-extra-light {
		font-weight: var(--font-weight-extra-light);
	}

	.font-light {
		font-weight: var(--font-weight-light);
	}

	.font-normal {
		font-weight: var(--font-weight-normal);
	}

	.font-medium {
		font-weight: var(--font-weight-medium);
	}

	.font-semi-bold {
		font-weight: var(--font-weight-semi-bold);
	}

	.font-bold {
		font-weight: var(--font-weight-bold);
	}

	.font-extra-bold {
		font-weight: var(--font-weight-extra-bold);
	}

	.font-heavy {
		font-weight: var(--font-weight-heavy);
	}


	/* Font color */
	.color-secondary {
		color: var(--color-foreground-secondary);
	}

	/* Font family */
	.font-secondary {
		font-family: var(--font-family-secondary);
		letter-spacing: 1px;
	}

	/* letter spacing */
	.ls-tight {
		letter-spacing: -.05em;
	}

	/* letter spacing */
	.lh-lg {
		line-height: var(--size-lg);
	}
	.lh-xl {
		line-height: var(--size-xl);
	}
	.lh-2xl {
		line-height: var(--size-2xl);
	}
	.lh-3xl {
		line-height: var(--size-3xl);
	}

	/* Display */
	.d-block {
		display: block;
	}

	/* Display */
	.mr-auto {
		margin-right: auto;
	}
	.mt-auto {
		margin-top: auto;
	}
	.mb-sm {
		margin-bottom: var(--size-sm);
	}
	.mr-sm {
		margin-right: var(--size-sm);
	}
	.mb-2xl {
		margin-bottom: var(--size-2xl);
	}
	.mr-2xl {
		margin-right: var(--size-2xl);
	}

	/* Utils */
	.ws-nowrap {
		white-space: nowrap;
	}
</style>
