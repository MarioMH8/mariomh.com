---
import Layout from '@layout';
import Heading from '@mariomh/heading/astro';
import Paragraph from '@mariomh/paragraph/astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const collectionEntries = await getCollection('post');

	return collectionEntries.map(entry => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
---

<Layout>
	<article class='container py-24'>
		<Heading
			class='text-center text-6xl mb-12 md:mb-18 lg:mb-24 text-balance'
			heading='h1'>
			{data.title}
		</Heading>
		<Image
			alt={data.imageAlt}
			class='w-screen mx-auto blog-image'
			src={data.image}
		/>
		{
			data.resume && (
				<Paragraph
					class='max-w-3xl text-center mx-auto my-12 md:my-18 lg:my-24 !leading-5xl'
					dimension='3xl'
					family='secondary'>
					{data.resume}
				</Paragraph>
			)
		}
		<div class='w-[75ch] mx-auto'>
			<Content />
		</div>
	</article>
</Layout>

<style>
	.blog-image {
		mask-image: url(/shape.svg);
		mask-repeat: no-repeat;
		mask-size: cover;
		transform: translateX(15%);
		mask-size: 85vw;
	}
</style>
