---
import Footer from '@features/footer.astro';
import Nav from '@features/nav.astro';
import Layout from '@layout';
import Heading from '@mariomh8/heading/astro';
import Paragraph from '@mariomh8/paragraph/astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const collectionEntries = await getCollection('post');

	return collectionEntries.map(entry => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
---

<Layout class='overflow-x-hidden'>
	<Nav blog />
	<article class='container py-24'>
		<Heading
			class='text-center text-6xl mb-12 md:mb-18 lg:mb-24 text-balance'
			heading='h1'>
			{data.title}
		</Heading>
		<Image
			alt={data.imageAlt}
			class='w-screen mx-auto blog-image'
			src={data.image}
		/>
		{
			data.resume && (
				<Paragraph
					class='max-w-3xl text-center mx-auto mb-12 md:mb-18 lg:mb-24 !leading-5xl'
					dimension='3xl'
					family='secondary'>
					{data.resume}
				</Paragraph>
			)
		}
		<div class='max-w-[75ch] mx-auto article'>
			<Content />
		</div>
	</article>
	<Footer />
</Layout>

<style>
	@reference '../../../layouts/layout.css';

	.blog-image {
		mask-image: url(/assets/shape.svg);
		mask-repeat: no-repeat;
		transform: translateX(15%);
		mask-size: 75vw;
	}

	.article {
		h2 {
			@apply font-primary mb-8 text-2xl;
		}
		p {
			@apply font-secondary mb-6 tracking-wide;
		}
	}
</style>
