</BaseLayout>

<style>
	section {
		width: 100%;
		height: 100svh;
		display: flex;
		flex-flow: row;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	h1 {
		width: fit-content;
		font-size: 2rem;
	}
</style>
