---
import Heading from '@mariomh/heading/astro'
import Paragraph from '@mariomh/paragraph/astro'
import {Image} from 'astro:assets'
import {getCollection} from "astro:content";

import H2 from "@/features/post/h2.astro";
import Layout from "@/layouts/layout.astro";

export async function getStaticPaths() {
    const collectionEntries = await getCollection('post');

    return collectionEntries
        .map(entry => ({
            params: {slug: entry.slug}, props: {entry},
        }));
}

const {entry} = Astro.props;
const data = entry.data;
const {Content} = await entry.render();
---

<Layout blog>
	<article class="container py-24">
		<Heading size='h1' weight='medium'
				 class="text-center text-6xl mb-12 md:mb-18 lg:mb-24 text-balance">{data.title}</Heading>
		<Image
			src={data.image}
			alt={data.imageAlt}
			class="w-screen mx-auto blog-image"/>
        {data.resume &&
			<Paragraph
				size='3xl'
				weight='medium'
				family='secondary'
				class="max-w-3xl text-center mx-auto my-12 md:my-18 lg:my-24 !leading-5xl">
                {data.resume}
			</Paragraph>}
		<div class="w-[75ch] mx-auto">
			<Content components={{p: Paragraph, h2: H2}}/>
		</div>
	</article>
</Layout>

<style>
    .blog-image {
        mask-image: url(/shape.svg);
        mask-repeat: no-repeat;
        transform: translateX(15%);
        //mask-size: 85vw;
    }
</style>
