---
import BaseLayout from '../layouts/base.astro';
---

<BaseLayout>
	<section>
		<div class="card">
			<img src="/images/logo/white.png" alt="MarioMH logo" class="logo"/>
			<h1>Mar<span class="accent i1">i</span>o Men<span class="accent e">&eacute;</span>ndez H<span class="accent i2">i</span>dalgo</h1>
			<h2>Desarrollador Full Stack</h1>
			<div class="links">
				<a href="mailto:hola@mariomh.com">hola@mariomh.com</a>
				<a href="/">mariomh.com</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	body {
		background-color: rgb(167,167,167);
		background-color: linear-gradient(135deg, rgba(167,167,167,1) 42%, rgba(128,128,128,1) 100%);
	}
	section {
		width: 100%;
		height: 100vh;
	    display: flex;
	    justify-content: center;
        align-items: center;

		-webkit-user-select: none; /* Safari */
		-ms-user-select: none; /* IE 10 and IE 11 */
		user-select: none; /* Standard syntax */
	}

	.card {
		aspect-ratio: 18 / 10;
		background-color: var(--color-primary);
        width: min(calc(var(--size-4xl) * 8), 90vw);
        border-radius: 2px;
        box-shadow: 2px 2px 15px 0px rgb(0 0 0 / 75%);
        padding: var(--size-base);
		text-align: center;
		color: var(--color-white);
		font-weight: 200;
	}

	.logo {
		position: relative;
		display: inline-block;
		margin: 0 auto;
		height: 40%
	}

	h1 {
		font-size: var(--size-xl);
		line-height: var(--size-xl);
		font-weight: 400;
	}

	h2 {
		font-size: var(--size-lg);
		margin-top: var(--size-base)
	}

	.accent {
        position:relative;
	}

	.accent:after {
	    position: absolute;
	    left: 0;
	    overflow: hidden;
	    z-index: 40;
	    height: 17%;
	}

	.i1:after {
	    content: "i";
	    color: var(--color-accent-1);
	}

	.e:after {
	    content: "é";
	    color: var(--color-accent-2);
	}

	.i2:after {
	    content: "i";
	    color: var(--color-accent-3);
	}

	.links {
		display: flex;
        flex-flow: row wrap;
        justify-content: space-around;
		margin-top: var(--size-lg)
	}
</style>

