---
import 'atropos/css'
import BaseLayout from '../layouts/base.astro';

const EMAIL = 'hola@mariomh.com';
const MAIL_TO = `mailto:${EMAIL}`;
---

<BaseLayout>
	<section>
		<!-- main Atropos container (required), add your custom class here -->
		<div class="atropos my-atropos">
			<!-- scale container (required) -->
			<div class="atropos-scale">
				<!-- rotate container (required) -->
				<div class="atropos-rotate">
					<!-- inner container (required) -->
					<div class="atropos-inner">
						<div class="card">
							<img
								class="logo"
								src="favicon.svg"
								alt="MarioMH icon"
								height="150"
								width="150" />
							<h1 class="name">Mario Men&eacute;ndez <br/>Hidalgo</h1>
							<p class="info">
								<a class="link" href={MAIL_TO} target='_self'>
									{EMAIL}
								</a>
								<a class="link" href='/'>
									www.mariomh.com
								</a>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>


<style>

	section {
		width: 100%;
		height: 100vh;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.card {
		border-radius: var(--size-lg);
	}
	.card {
		aspect-ratio: 16 / 10;
		background-color: var(--color-background-card);
		width: min(calc(var(--size-4xl) * 7.5), 90vw);
		padding: var(--size-3xl);
		text-align: center;
		font-weight: 200;
		color: var(--color-foreground-card);

		display: grid;
		grid-template-columns:auto 3fr;
		grid-template-rows: min-content auto;
		column-gap: var(--size-base);
		grid-template-areas:
		". ."
		". info";
	}

	.name {
		width: fit-content;
		height: fit-content;
		text-align: left;
		font-size: var(--size-lg);
		margin: auto 0;
	}

	.logo {
		width: calc( var(--size-xl) * 3);
		height: calc( var(--size-xl) * 3);
		margin-left: auto;
	}

	.info {
		grid-area: info;
		text-align: left;
		margin-top: auto;
		display: flex;
		flex-flow: column nowrap;
		gap: var(--size-xs);
	}

	.link {
		width: fit-content;
		border-bottom: 1px dashed transparent;
	}

	.link:hover {
		border-bottom-color: var(--color-foreground-card);
	}
</style>

<script>
	import Atropos from 'atropos';
	import type { AtroposOptions } from 'atropos';

	const options: AtroposOptions = {
		el: '.atropos',
		activeOffset: 30,
		shadowOffset: 50,
		rotateXMax: 5,
		rotateYMax: 5,
		alwaysActive: true
	}

	Atropos(options)
</script>
