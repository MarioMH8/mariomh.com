---
import { SEO } from "astro-seo";
import AppStyles from '../styles/app.astro'
import FontsStyles from '../styles/fonts.astro'
import ResetStyles from '../styles/reset.astro'
import ScrollbarStyles from '../styles/scrollbar.astro'
import Wrapper from "../components/wrapper.astro";
---

<!DOCTYPE html>
<html lang="es-ES">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

	<SEO
		title="MarioMH | Desarrollador Web"
		description="MarioMH es un desarrollador Web especializado en JavaScript."
		openGraph={{
			basic: {
				title: "MarioMH desarrollador Web",
				type: "website",
				image: "/og/mariomh.png",
			}
		}}
		twitter={{
			creator: "@MarioMH8"
		}}
	/>
	<link rel="sitemap" href="/sitemap-index.xml">

	<meta name="theme-color" content="#fdfff5" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#001B16" media="(prefers-color-scheme: dark)">

	<script src="/src/pwa.ts"></script>

	<AppStyles/>
	<FontsStyles/>
	<ResetStyles/>
	<ScrollbarStyles/>
</head>
<body>
<Wrapper>
	<slot/>
</Wrapper>
</body>
</html>
