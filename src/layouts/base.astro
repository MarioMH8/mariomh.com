---
import { SEO } from "astro-seo";
import GlobalStyles from '../components/common/GlobalStyles.astro'
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

	<SEO
		title="MarioMH | Desarrollador JavaScript"
		description="MarioMH es un desarrollador Full Stack especializado en JavaScript."
		openGraph={{
			basic: {
				title: "MarioMH desarrollador JavaScript",
				type: "website",
				image: "https://user-images.githubusercontent.com/5182256/131216951-8f74f425-f775-463d-a11b-0e01ad9fce8d.png",
			}
		}}
		twitter={{
			creator: "@MarioMH8"
		}}
	/>
	<link rel="sitemap" href="/sitemap-index.xml">

	<GlobalStyles/>
</head>
<body class="no-scrollbar">
<main>
	<slot/>
</main>
</body>
</html>
