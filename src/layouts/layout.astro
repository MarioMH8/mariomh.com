---
import '@mariomh/archia/100.css';
import '@mariomh/archia/300.css';
import '@mariomh/archia/400.css';
import '@mariomh/archia/500.css';
import '@mariomh/archia/600.css';
import '@mariomh/archia/700.css';
import '@fontsource/dm-sans/100.css';
import '@fontsource/dm-sans/200.css';
import '@fontsource/dm-sans/300.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/dm-sans/800.css';
import '@fontsource/dm-sans/900.css';
import './layout.css';

import resume from '@mariomh/resume/resume.json';
import type { HTMLTag, Polymorphic } from 'astro/types';
import { ClientRouter } from 'astro:transitions';
import { SEO } from 'astro-seo';

type Props<Tag extends HTMLTag = 'body'> = Polymorphic<{ as: Tag }> & {
	title?: string;
	description?: string;
};

const { description, title, ...properties } = Astro.props;
const { label, name } = resume.basics ?? {};
const nameLabel = [name, label].filter(Boolean).join(' - ');
const summary = resume.basics?.summary;
const titleName = [title, name].filter(Boolean).join(' - ');
const computedTitle = title ? titleName : nameLabel;
const computedDescription = description ?? (typeof summary === 'string' ? summary : '');
---

<!doctype html>
<html lang='es'>
	<head>
		<meta charset='utf-8' />

		<meta
			content='width=device-width, initial-scale=1.0'
			name='viewport'
		/>

		<meta
			content='#F5F5F5'
			id='meta-light'
			media='(prefers-color-scheme: light)'
			name='theme-color'
		/>

		<meta
			content='#001C16'
			id='meta-dark'
			media='(prefers-color-scheme: dark)'
			name='theme-color'
		/>

		<meta
			content={Astro.generator}
			name='generator'
		/>

		<link
			href='/sitemap-index.xml'
			rel='sitemap'
		/>

		<SEO
			description={computedDescription}
			openGraph={{
				basic: {
					image: '/og.webp',
					title: nameLabel,
					type: 'website',
				},
			}}
			title={computedTitle}
		/>

		<ClientRouter />

		<script>
			window.getSystemTheme = (): string => {
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};

			window.getThemePreference = (): string => {
				const localItem = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
				if (localItem === 'dark' || localItem === 'light') {
					return localItem;
				}

				return window.getSystemTheme();
			};

			function toggleTheme() {
				const element = document.documentElement;
				const isDark = window.getThemePreference() === 'dark';
				const hasDark = element.classList.contains('dark');
				if (isDark !== hasDark) {
					element.classList.toggle('dark', isDark);
				}
				const hasDarkScrollbar = element.classList.contains('scrollbar-track-primary-dark-background');
				if (isDark !== hasDarkScrollbar) {
					element.classList.toggle('scrollbar-track-primary-dark-background', isDark);
				}
			}

			function revealEmail() {
				const buttons = document.getElementsByClassName('hidden-email');

				for (const button of buttons) {
					const onClick = (event: Event) => {
						const href = button.getAttribute('href');
						const email = button.getAttribute('data-email')?.replace(/AT/, '@').replace(/DOT/, '.');
						if (!href && email) {
							event.preventDefault();
							const emailLink = `mailto:${email}`;
							button.classList.remove('hidden-email');
							button.setAttribute('href', emailLink);
							window.location.href = emailLink;
							button.removeEventListener('click', onClick);
						}
					};
					button.addEventListener('click', onClick);
				}
			}

			document.addEventListener('astro:page-load', () => {
				toggleTheme();
				revealEmail();
			});

			toggleTheme();
		</script>
	</head>
	<body
		{...properties}
		class:list={[properties.class]}>
		<slot />
	</body>
</html>
