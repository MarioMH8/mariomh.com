---
import Box from '@mariomh/box/astro';
import Button from '@mariomh/button/astro';
import Heading from '@mariomh/heading/astro';
import Input from '@mariomh/input/astro';
import Label from '@mariomh/label/astro';
import TextArea from '@mariomh/textarea/astro';
import {X} from 'lucide-astro';

import Dialog from '../components/dialog.astro';
---
<Dialog id="contact">
	<Box className="w-[90vw] max-w-[680px] min-h-[720px] bg-primary-1 dark:bg-primary-12 py-8 relative" round='2xl'>
		<Heading size="h2" weight="medium" className="text-5xl mb-12 text-center">¡Hablemos!</Heading>
		<Button
			icon
			link
			className="absolute top-[2.5rem] right-[2.5rem]"
			id="contact-form-close">
			<X/>
			<span class="sr-only">Cerrar</span>
		</Button>
		<form
			id="contact-form"
			method="post"
			class="max-w-[550px] mx-auto flex flex-col gap-8" >
			<Label family="secondary">
				Nombre
				<Input
					placeholder="Elvira Casanovas"
					className="form_data mt-4 border-secondary-11"
					family="secondary"
					transparent
					autocomplete="name"
					name="name"
					required/>
			</Label>
			<Label family="secondary">
				Email
				<Input
					placeholder="ecasanovas@domain.es"
					className="form_data mt-4 border-secondary-11"
					family="secondary"
					required
					transparent
					autocomplete="email"
					name="email"
					type="email"/>
			</Label>
			<Label family="secondary">
				Mensaje
				<TextArea
					placeholder="Me pongo en contacto con usted para..."
					className="form_data mt-4 border-secondary-11"
					family="secondary"
					required
					name="message"
					transparent/>
			</Label>
			<Button type="submit" family="secondary" solid>Enviar mensaje</Button>
			<span id="contact-form-success" class="hidden text-primary-10 mx-auto text-center">Mensaje enviado correctamente</span>
			<span id="contact-form-error" class="hidden text-danger-10 mx-auto text-center">
				Hubo un error al enviar tu mensaje, sin embargo puedes escribirme algo bonito a
				<a href="mailto:hola@mariomh.com" class="text-primary-10">hola@mariomh.com</a>.
			</span>
		</form>
	</Box>
</Dialog>


<script>
	import type { FirebaseApp } from '@firebase/app';

	document.addEventListener('astro:page-load', () => {

		// @ts-expect-error - This is a debug token, it's fine to have it here
		self.FIREBASE_APPCHECK_DEBUG_TOKEN = import.meta.env.PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN;

		let app: FirebaseApp | undefined = undefined;

		async function initializeFirebase(): Promise<FirebaseApp> {
			const { initializeApp } = await import('@firebase/app');
			const { initializeAppCheck, ReCaptchaV3Provider } = await import('@firebase/app-check');
			const app = initializeApp({
				apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
				appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
				authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
				messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
				storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
				projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT,
			});
			initializeAppCheck(app, {
				provider: new ReCaptchaV3Provider(import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY),
				isTokenAutoRefreshEnabled: true,
			});

			return app;
		}

		const $form = document.getElementById('contact-form') as HTMLFormElement;
		const $closeButton = document.getElementById('contact-form-close') as HTMLButtonElement;
		const $error = document.getElementById('contact-form-error') as HTMLSpanElement;
		const $success = document.getElementById('contact-form-success') as HTMLSpanElement;
		const $dialog = document.getElementById('contact') as HTMLDialogElement;
		const $buttons = document.querySelectorAll<HTMLButtonElement>('[data-dialog]');

		function showErrorMessages() {
			$error.classList.remove('hidden');
			$success.classList.add('hidden');
		}

		function showSentMessage() {
			$error.classList.add('hidden');
			$success.classList.remove('hidden');
			$form.reset();
		}

		function closeDialog() {
			$error.classList.add('hidden');
			$success.classList.add('hidden');
			$form.reset();
			$dialog.close();
		}

		function disableFormElements<T extends HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | HTMLButtonElement>(
			collection: HTMLCollectionOf<T>,
			disabled: boolean
		) {
			for (let i = 0; i < collection.length; i++) {
				const item = collection.item(i);
				if (item) {
					item.disabled = disabled;
				}
			}
		}

		function disableForm(bDisabled: boolean) {
			const inputs = $form.getElementsByTagName('input');
			disableFormElements(inputs, bDisabled);
			const selects = $form.getElementsByTagName('select');
			disableFormElements(selects, bDisabled);
			const textareas = $form.getElementsByTagName('textarea');
			disableFormElements(textareas, bDisabled);
			const buttons = $form.getElementsByTagName('button');
			disableFormElements(buttons, bDisabled);
		}

		async function submitContactForm(e: SubmitEvent) {
			e.preventDefault();
			const formData = new FormData($form);
			const object: Record<string, FormDataEntryValue> = {};
			formData.forEach((value, key) => {
				object[key] = value;
			});
			const { getFunctions, httpsCallableFromURL } = await import('@firebase/functions');
			try {
				disableForm(true);
				const functions = getFunctions(app);
				const sendMail = httpsCallableFromURL(functions, import.meta.env.PUBLIC_FIREBASE_FUNCTIONS_SEND_MAIL);
				await sendMail(object);
				showSentMessage();
			} catch (e) {
				showErrorMessages();
				console.error(e);
			} finally {
				disableForm(false);
			}
		}

		$form.addEventListener('submit', e => void submitContactForm(e));
		$closeButton.addEventListener('click', closeDialog);
		$buttons.forEach(btn => {
			btn.addEventListener('click', () => {
				if (app) {
					$dialog.showModal();
				} else {
					void initializeFirebase().then(a => {
						app = a;
						$dialog.showModal();
					});
				}
			});
		});
	});
</script>
