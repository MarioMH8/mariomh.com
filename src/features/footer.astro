---
import cn from '@mariomh/button/cn'
import Copyright from '@mariomh/copyright/astro'
import {Github,Linkedin,Twitter} from 'lucide-astro'

import ThemeToggle from './theme-toggle.astro'

const cls = cn({solid: true, icon: true})
---

<footer class='bg-primary-12 dark:bg-primary-dark-12 w-full pt-[5dvh] pb-[10dvh] flex flex-col gap-[5dvh] justify-center items-center'>
	<div class='flex flex-row gap-8 items-center'>
		<a class={cls} href='https://twitter.com/MarioMH8' target='_blank'>
			<Twitter/>
			<span class="sr-only">Twitter</span>
		</a>
		<a class={cls} href='https://github.com/MarioMH8' target='_blank'>
			<Github/>
			<span class="sr-only">GitHub</span>
		</a>
		<a class={cls} href='https://www.linkedin.com/in/mhidalgomario/' target='_blank'>
			<Linkedin/>
			<span class="sr-only">LinkedIn</span>
		</a>
		<ThemeToggle/>
	</div>
	<Copyright className='text-primary-1 dark:text-primary-12' weight='light' size='sm' />
</footer>
