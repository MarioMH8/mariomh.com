---
import Logo from "../components/logo.astro";
import Button from "../components/button.astro";
---

<nav>
	<ul>
		<li class="mr-auto"><Logo/></li>
		<li class="font-secondary"><a title="Ir a la sección sobre mi" href="#about">Sobre mi</a></li>
		<li class="font-secondary"><a title="Ir a la sección portfolio" href="#portfolio">Portfolio</a></li>
		<li class="font-secondary"><a title="Ir a la sección servicios" href="#services">Servicios</a></li>
		<li class="font-secondary"><a title="Ir a al blog" href="/blog">Blog</a></li>
		<li><Button title="Botón ">Cont&aacute;ctame</Button></li>
	</ul>
</nav>

<style>
	nav ul {
		display: flex;
		flex-flow: row nowrap;
		justify-content: flex-end;
		align-items: center;
		gap: var(--size-base);
	}

	nav li > a {
		padding: var(--size-sm) var(--size-lg);
		border-bottom: 2px solid transparent;
	}

	nav li > a:hover,
	nav li > a:focus {
		border-bottom-color: var(--color-foreground);
	}

	nav li > a:active {
		border-bottom-color: var(--color-foreground);
	}

	@media (width < 1200px) {
		nav li {
			display: none;
		}

		nav li:last-child,
		nav li:first-child {
			display: block;
		}
	}

	@media (width < 550px) {
		nav li:last-child {
			display: none;
		}
	}
</style>

<script>
	document.querySelectorAll('a[href^="#"]').forEach(anchor => {
		anchor.addEventListener('click', function (e) {
			e.preventDefault();

			document.querySelector(this.getAttribute('href')).scrollIntoView({
				behavior: 'smooth'
			});
		});
	});
</script>
