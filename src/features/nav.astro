---
import Button from '@mariomh/button/astro';
import { NavigationMenu, NavigationMenuLI, NavigationMenuLink } from '@mariomh/navigation-menu/astro';

interface Props {
	blog?: boolean;
}

const {blog} = Astro.props;
---

<NavigationMenu class='py-4'>
	<NavigationMenuLI>
		<NavigationMenuLink href={blog ? '/#sobre-mi' : '#sobre-mi'}>Sobre mi</NavigationMenuLink>
	</NavigationMenuLI>
	<NavigationMenuLI>
		<NavigationMenuLink href={blog ? '/#portfolio' : '#portfolio'}>Portfolio</NavigationMenuLink>
	</NavigationMenuLI>
	<NavigationMenuLI>
		<NavigationMenuLink href={blog ? '/#servicios' : '#servicios'}>Servicios</NavigationMenuLink>
	</NavigationMenuLI>
	<NavigationMenuLI>
		<NavigationMenuLink
			active={blog === true}
			href='/blog'>
			Blog
		</NavigationMenuLink>
	</NavigationMenuLI>
	<NavigationMenuLI>
		<Button
			as='a'
			data-email='holaATmariomhDOTcom'
			className='cursor-pointer hidden-email'
			variant='solid'>
			Contáctame
		</Button>
	</NavigationMenuLI>
</NavigationMenu>
