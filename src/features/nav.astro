---
import Button from '@mariomh8/button/astro';
import { NavigationMenu, NavigationMenuLI, NavigationMenuLink } from '@mariomh8/navigation-menu/astro';

interface Props {
	blog?: boolean;
}

const { blog } = Astro.props;
---

<NavigationMenu class='py-4'>
	{blog ? (
		<NavigationMenuLI>
			<NavigationMenuLink href='/'>Inicio</NavigationMenuLink>
		</NavigationMenuLI>
	) : (
		<>
			<NavigationMenuLI>
				<NavigationMenuLink href={blog ? '/#sobre-mi' : '#sobre-mi'}>Sobre mi</NavigationMenuLink>
			</NavigationMenuLI>
			<NavigationMenuLI>
				<NavigationMenuLink href={blog ? '/#portfolio' : '#portfolio'}>Portfolio</NavigationMenuLink>
			</NavigationMenuLI>
			<NavigationMenuLI>
				<NavigationMenuLink href={blog ? '/#servicios' : '#servicios'}>Servicios</NavigationMenuLink>
			</NavigationMenuLI>
		</>
	)}
	<NavigationMenuLI>
		<NavigationMenuLink
			active={blog === true}
			href='/blog'>
			Blog
		</NavigationMenuLink>
	</NavigationMenuLI>
	<NavigationMenuLI>
		<Button
			as='a'
			className='cursor-pointer'
			data-obfuscation='0'
			href='mailto:hola@mariomh.com'
			variant='solid'>
			Contáctame
		</Button>
	</NavigationMenuLI>
</NavigationMenu>
