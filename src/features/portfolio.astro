---
import PortfolioPreview from '@features/portfolio-preview.astro';
import Button from '@mariomh/button/astro';
import Container from '@mariomh/container/astro';
import Heading from '@mariomh/heading/astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('project');
---

<Container
	as='section'
	class='w-full flex flex-col items-center gap-6 pt-[5dvh]'
	id='portfolio'>
	<Heading
		className='m-0 dark:text-primary'
		dimension='xl'
		family='secondary'
		heading='h2'
		weight='light'>
		Portfolio
	</Heading>
	<Heading
		dimension='6xl'
		heading='h3'
		weight='medium'>
		Proyectos recientes
	</Heading>

	<nav class='flex flex-row flex-wrap gap-8 items-center justify-center mb-16'>
		<Button
			className='portfolio-btn'
			variant='solid'>
			Todos
		</Button>
		<Button
			className='portfolio-btn'
			data-show='portfolio'>
			Webs
		</Button>
		<Button
			className='portfolio-btn'
			data-show='app'>
			Apps
		</Button>
		<Button
			className='portfolio-btn'
			data-show='lib'>
			Librerías
		</Button>
	</nav>

	<div class='grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-16 lg:gap-y-24 justify-evenly lg:mb-56'>
		{
			projects.map((project, index) => (
				<PortfolioPreview
					className={`lg:even:translate-y-[10rem] ${index < 4 ? '' : 'hidden'}`}
					project={project}
				/>
			))
		}
	</div>

	<Button id='show-more'> Más proyectos </Button>
</Container>

<script src='./portfolio.ts'></script>
