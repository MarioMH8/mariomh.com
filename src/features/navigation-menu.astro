---
import Button from '@mariomh/button/astro';
import NavBar from '@mariomh/navigation-menu/astro';
import NavBarLi from '@mariomh/navigation-menu/astro/li';
import NavigationMenuLink from '@mariomh/navigation-menu/astro/link';

interface Props {
    blog?: boolean;
}

const {blog} = Astro.props;
---

<NavBar>
	<NavBarLi>
		<NavigationMenuLink className='font-secondary' href='/#sobre-mi'>Sobre mi</NavigationMenuLink>
	</NavBarLi>
	<NavBarLi>
		<NavigationMenuLink className='font-secondary' href='/#portfolio'>Portfolio</NavigationMenuLink>
	</NavBarLi>
	<NavBarLi>
		<NavigationMenuLink className='font-secondary' href='/#servicios'>Servicios</NavigationMenuLink>
	</NavBarLi>
	<NavBarLi>
		<NavigationMenuLink className='font-secondary' href='/blog' active={blog === true}>Blog</NavigationMenuLink>
	</NavBarLi>
	<NavBarLi>
		<Button solid family='secondary' onclick="window.contact.showModal();">Contáctame</Button>
	</NavBarLi>
</NavBar>
