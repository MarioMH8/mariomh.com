---
import Button from '@mariomh/button/astro';
import Heading from '@mariomh/heading/astro';

import article from '../assets/coding.jpg';
import BlogPreview from './blog-preview.astro';
---

<section
	id='blog-recent'
	class:list={[
		'container w-full pt-[5dvh] md:pt-[10dvh] lg:pt-[15dvh]',
		'flex flex-col md:flex-row justify-between'
	]}>
	<div class='w-[33%]'>
		<Heading
			size='h2'
			weight='light'
			family='secondary'
			className='text-xl'>Blog</Heading>
		<Heading
			size='h3'
			weight='medium'
			className='text-6xl leading-7xl mb-12'>Noticias <br/> recientes</Heading>

		<Button bordered transparent className='px-12 py-3 w-fit round-xl border-primary-foreground' size='lg' family='secondary'>
			Ver más
		</Button>
	</div>
	<div class='w-[66%] flex flex-row gap-12 overflow-x-auto scrollbar-thin scrollbar-thumb-primary scrollbar-track-primary-background-subtle scrollbar-thumb-rounded'>
		<BlogPreview
			alt='Alt text'
			src={article}
			article='VISUAL STUDIO CODE: PRODUCTIVIDAD Y SETUP'/>

		<BlogPreview
			alt='Alt text'
			src={article}
			article='VISUAL STUDIO CODE: PRODUCTIVIDAD Y SETUP'/>

		<BlogPreview
			alt='Alt text'
			src={article}
			article='VISUAL STUDIO CODE: PRODUCTIVIDAD Y SETUP'/>

		<BlogPreview
			alt='Alt text'
			src={article}
			article='VISUAL STUDIO CODE: PRODUCTIVIDAD Y SETUP'/>

		<BlogPreview
			alt='Alt text'
			src={article}
			article='VISUAL STUDIO CODE: PRODUCTIVIDAD Y SETUP'/>


	</div>
</section>
