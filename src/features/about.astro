---
import Button from "../components/button.astro";---

<section id="about">
	<h2>Sobre mi</h2>
	<p>Soy un desarrollador apasionado por la tenolog&iacute;a y la b&uacute;squeda de soluciones de todo tipo de proyectos desafiantes.</p>
	<Button secondary>Hablemos</Button>
</section>

<style>
	section {

		padding: var(--size-2xl);
		background-color: var(--color-primary-200);

		width: 100%;
		min-height: max(70vmin, 600px);

		border-radius: var(--size-lg);

		flex: .5;
	}

	h2 {
		display: block;
		font-weight: 500;
		color: var(--color-primary-500);
		margin-bottom: var(--size-lg);
		font-size: var(--size-lg)
	}

	p {
		font-weight: 500;
		font-size: var(--size-2xl);
		text-wrap: balance;
		margin-bottom: var(--size-3xl);
	}

	@media (width < 1200px) {
		section {
			flex: 1;
			flex-basis: 100%;
			min-height: max(50vmin, 400px);
		}
	}
</style>
