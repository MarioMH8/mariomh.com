---
import Badge from '@mariomh/badge/astro';
import fontCn from '@mariomh/font/cn';
import type {FontVariantsProps} from '@mariomh/font/variants';
import Link from '@mariomh/link/astro';
import {Image} from 'astro:assets'
import type {CollectionEntry} from 'astro:content';

const titleCn = [
	fontCn({size: 'xl'} as FontVariantsProps),
	'uppercase text-balance',
]

interface Props {
	post: CollectionEntry<'post'>;
	direction?: 'horizontal' | 'vertical';
}
const {post, direction = 'vertical'} = Astro.props;

const vertical = direction === 'vertical';

---
<article class:list={[
	'transition-transform hover:scale-110 focus-within:scale-110',
	'flex flex-col gap-6 w-[50%] min-w-[360px] max-w-[550px]',
	'[&_a_span]:opacity-0',
	'[&:hover_img]:backdrop-blur-2xl [&:hover_img]:brightness-[.25] [&:hover_a_span]:opacity-100',
	'[&_a:focus_img]:backdrop-blur-2xl [&_a:focus_img]:brightness-[.25] [&_a:focus_span]:opacity-100',
]}>

	<Link
		family='secondary'
		href={`/post/${post.slug}`}
		title={`Leer artículo '${post.data.title}'`}
		className={`rounded-2xl relative text-lg ${vertical ? 'aspect-[10/13]' : 'aspect-[7/5]'}`}>
		<Image
			src={post.data.image}
			alt={post.data.imageAlt}
			class='rounded-2xl h-full object-cover object-center'/>
		<span class='absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-primary-1'> Leer artículo</span>
	</Link>
	<div class="flex flex-row flex-wrap gap-4">
		{post.data.tags.map(tag =>
			<Badge className='w-min' family='secondary' size='sm'>{tag}</Badge>
		)}
	</div>
	<header class:list={titleCn}>
		{post.data.title}
	</header>
</article>
