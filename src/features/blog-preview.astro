---
import Badge from '@mariomh/badge/astro';
import fontCn from '@mariomh/font/class-name';
import Heading from '@mariomh/heading/astro';
import Link from '@mariomh/link/astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'post'>;
	direction?: 'horizontal' | 'vertical';
	layout?: 'carousel' | 'grid';
	titleHeading?: 'h2' | 'h4';
}

const titleCn = [fontCn({ dimension: 'xl' }), 'uppercase text-balance'];

const { direction = 'vertical', layout = 'carousel', post, titleHeading = 'h4' } = Astro.props;

const vertical = direction === 'vertical';
const grid = layout === 'grid';
---

<article
	class:list={[
		'transition-transform',
		{
			'hover:-translate-y-1 focus-within:-translate-y-1': grid,
			'hover:scale-110 focus-within:scale-110': !grid,
		},
		'flex flex-col gap-6',
		{
			'w-[50%] min-w-[360px] max-w-[550px]': !grid,
			'w-full min-w-0 max-w-none': grid,
		},
		'[&_a_span]:opacity-0',
		'[&:hover_img]:backdrop-blur-2xl [&:hover_img]:brightness-[.25] [&:hover_a_span]:opacity-100',
		'[&_a:focus_img]:backdrop-blur-2xl [&_a:focus_img]:brightness-[.25] [&_a:focus_span]:opacity-100',
	]}>
	<Link
		aria-label={`Leer artículo: ${post.data.title}`}
		className={`rounded-2xl relative text-lg ${vertical ? 'aspect-[10/13]' : 'aspect-[7/5]'}`}
		family='secondary'
		href={`/blog/post/${post.slug}`}
		title={`Leer artículo: ${post.data.title}`}>
		<Image
			alt={post.data.imageAlt}
			class='rounded-2xl h-full object-cover object-center'
			src={post.data.image}
		/>
		<span class='absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-primary-1'>
			Leer artículo
		</span>
	</Link>
	<div class='flex flex-row flex-wrap gap-4'>
		{
			post.data.tags.map(tag => (
				<Badge
					className='w-min'
					dimension='sm'
					family='secondary'>
					{tag}
				</Badge>
			))
		}
	</div>
	<header class:list={titleCn}>
		<Heading
			className='text-inherit'
			heading={titleHeading}
			weight='medium'>
			<Link
				className='text-inherit no-underline'
				family='secondary'
				href={`/blog/post/${post.slug}`}
				title={`Leer artículo: ${post.data.title}`}>
				{post.data.title}
			</Link>
		</Heading>
	</header>
</article>
