---
import Badge from '@mariomh8/badge/astro';
import fontCn from '@mariomh8/font/class-name';
import Link from '@mariomh8/link/astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'post'>;
	direction?: 'horizontal' | 'vertical';
}

const titleCn = [fontCn({ dimension: 'xl' }), 'uppercase text-balance'];

const { direction = 'vertical', post } = Astro.props;

const isVertical = direction === 'vertical';
---

<article
	class:list={[
		'transition-transform hover:scale-110 focus-within:scale-110',
		'flex flex-col gap-6 w-[50%] min-w-[360px] max-w-[550px]',
		'[&_a_span]:opacity-0',
		'[&:hover_img]:backdrop-blur-2xl [&:hover_img]:brightness-[.25] [&:hover_a_span]:opacity-100',
		'[&_a:focus_img]:backdrop-blur-2xl [&_a:focus_img]:brightness-[.25] [&_a:focus_span]:opacity-100',
	]}>
	<Link
		className={`rounded-2xl relative text-lg ${isVertical ? 'aspect-[10/13]' : 'aspect-[7/5]'}`}
		family='secondary'
		href={`/blog/post/${post.id}`}
		title={`Leer artículo '${post.data.title}'`}>
		<Image
			alt={post.data.imageAlt}
			class='rounded-2xl h-full object-cover object-center'
			src={post.data.image}
		/>
		<span class='absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-primary-1'>
			Leer artículo
		</span>
	</Link>
	<div class='flex flex-row flex-wrap gap-4'>
		{
			post.data.tags.map(tag => (
				<Badge
					className='w-min'
					dimension='sm'
					family='secondary'>
					{tag}
				</Badge>
			))
		}
	</div>
	<header class:list={titleCn}>
		{post.data.title}
	</header>
</article>
