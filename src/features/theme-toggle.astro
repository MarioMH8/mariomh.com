---
import Button from '@mariomh/button/astro';
import { Moon, Sun } from 'lucide-astro';
---

<Button
	class='inline-flex motion-safe:transition relative'
	icon
	id='theme-toggle'
	variant='solid'>
	<Sun class='absolute opacity-100 motion-safe:transition-transform dark:-rotate-90 dark:opacity-0' />
	<Moon class='absolute rotate-90 opacity-0 motion-safe:transition-transform dark:rotate-0 dark:opacity-100' />
	<span class='sr-only'></span>
</Button>

<script>
	const darkTheme = 'dark';
	const lightTheme = 'light';

	function onToggleTheme() {
		const element = document.documentElement;
		const isDark = element.classList.contains(darkTheme);

		localStorage.setItem('theme', isDark ? lightTheme : darkTheme);
		updateThemeMessage(isDark);
		element.classList.toggle(darkTheme);
		if (isDark) {
			element.classList.replace('scrollbar-track-primary-dark-background', 'scrollbar-track-primary-background');
		} else {
			element.classList.replace('scrollbar-track-primary-background', 'scrollbar-track-primary-dark-background');
		}
	}

	function updateThemeMessage(isDark: boolean) {
		const translation = isDark ? 'oscuro' : 'claro';
		const message = `Alternar tema, el tema actual es ${translation}`;
		const span = document.getElementById('theme-toggle')?.querySelector('span.sr-only');
		if (span) {
			span.innerHTML = message;
		}
	}

	const handleThemePreferenceChange = (event: MediaQueryListEvent) => {
		const isDark = document.documentElement.classList.contains('dark');
		const toggle = (event.matches && !isDark) || (!event.matches && isDark);
		if (toggle) {
			onToggleTheme();
		}
	};

	document.addEventListener('astro:page-load', () => {
		const themePreference = window.matchMedia('(prefers-color-scheme: dark)');
		themePreference.addEventListener('change', handleThemePreferenceChange);
		// Backward compatibility
		themePreference.addListener(handleThemePreferenceChange);

		document.getElementById('theme-toggle')?.addEventListener('click', onToggleTheme);
		updateThemeMessage(window.getThemePreference() === darkTheme);
	});
</script>
