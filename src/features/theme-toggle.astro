---
import Button from '@mariomh/button/astro';
import { Moon, Sun } from 'lucide-astro';
---

<Button
	class='inline-flex motion-safe:transition relative'
	icon
	id='theme-toggle'
	variant='solid'>
	<Moon class='absolute opacity-100 motion-safe:transition-transform dark:-rotate-90 dark:opacity-0' />
	<Sun class='absolute rotate-90 opacity-0 motion-safe:transition-transform dark:rotate-0 dark:opacity-100' />
	<span class='sr-only'></span>
</Button>

<script>
	const darkTheme = 'dark';

	function updateThemeMessage(isDark: boolean) {
		const translation = isDark ? 'oscuro' : 'claro';
		const message = `Alternar tema, el tema actual es ${translation}`;
		const span = document.getElementById('theme-toggle')?.querySelector('span.sr-only');
		if (span) {
			span.innerHTML = message;
		}
	}

	document.addEventListener('astro:page-load', () => {
		const currentTheme = window.themeManager.getCurrentTheme();
		document.getElementById('theme-toggle')?.addEventListener('click', () => window.themeManager.toggle());
		updateThemeMessage(currentTheme === darkTheme);
		window.themeManager.onThemeChange(theme => {
			const isDark = theme === darkTheme;
			updateThemeMessage(isDark);
		});
	});
</script>
