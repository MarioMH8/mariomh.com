---
import Nav from "./nav.astro";
---

<section>
	<Nav/>
	<h1 class="primary">
		<span class="secondary">Hola, soy Mario</span>
		Desarrollo Apps <br/>y p&aacute;ginas web<br/>sorprendentes
	</h1>
</section>

<style>
	section {
		flex-basis: 100%;
		padding: var(--size-2xl);
		background-color: var(--color-primary-600);

		width: 100%;
		min-height: max(75vmin, 550px);

		border-radius: var(--size-lg);

		color: var(--color-primary-100);

		display: flex;
		flex-flow: column nowrap;
		justify-content: space-between;
	}
	h1 {
		color: var(--color-primary-100);
		font-size: var(--size-4xl);
		font-weight: 500;
		letter-spacing: 1px;
		display: block;
	}
	.secondary {
		color: var(--color-primary-300);
		font-size: var(--size-lg);
		font-family: var(--font-family-secondary);
		font-weight: 300;
		letter-spacing: 1px;
		display: block;
		margin-bottom: var(--size-sm);
		margin-top: auto;
	}
</style>
