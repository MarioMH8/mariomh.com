---
import Heading from '@mariomh/heading/astro';
import Span from '@mariomh/span/astro';
import Box from '@mariomh/box/astro';
import { Image } from 'astro:assets'

import me from '@assets/me.png'
import Container from "@mariomh/container/astro";
---

<Container as="section" class='w-full flex flex-row flex-wrap justify-center items-start gap-x-12 pt-0 pb-[10dvh] lg:pb-0'>
	<Heading heading='h1' className='lg:min-w-[380px] max-w-[680px] text-8xl mb-10 !leading-[1.3]' weight='medium'>
		<Span weight='light' dimension='xl' className='mb-10 dark:text-primary'>Hola, soy Mario</Span><br />
		Desarrollo Apps <br/> y páginas web <br/> increíbles
	</Heading>
	<Box className='relative h-full w-full md:min-w-[360px] max-w-[550px] aspect-[10/9] xl:my-[15dvh] p-0 flex flex-col-reverse' round='2xl'>
		<Image src={me} alt='Mario Menéndez Hidalgo' class='h-[90%] max-h-[90%] w-auto mx-auto scale-x-[-1]'/>

		<svg viewBox="0 0 160 160" class="absolute max-w-[160px] aspect-square left-[-105px] bottom-[-105px]">

			<path
				transform="rotate(-90 84.8928 75.0544)"
				class="fill-primary-background-element"
				d="m105.46866,150.10877c-0.46871,-8.66586 -0.5203,-17.33209 -0.45828,-25.99751c0.13637,-19.04996 -12.846,-32.10076 -29.53791,-37.01197c-15.6904,-4.61654 -31.77842,-2.97543 -47.70351,-2.80839c-9.43316,0.09895 -18.39819,-8.21976 -17.9686,-18.14807c0.72695,-16.80031 0.52311,-33.6638 0.05993,-50.48281c-0.22307,-8.09998 8.35685,-15.39693 15.31067,-15.48323c16.82918,-0.20886 33.66639,-0.27237 50.49269,0.03089c6.9233,0.12478 13.87957,1.25994 16.48173,9.42534c0.33633,1.05541 0.78674,2.13608 0.82122,3.21663c0.38563,12.08621 0.16094,24.22035 1.17977,36.25018c1.09487,12.9277 2.57268,25.9842 13.59922,35.331c6.82113,5.78203 14.90705,8.43169 23.40663,9.55076c9.256,1.21865 18.6407,1.45984 28.40854,2.12718c0.43924,17.92745 0.43924,35.8549 0.43924,54c-18.02031,0 -36.0415,0 -54.53134,0z"/>
		</svg>

	</Box>
</Container>
