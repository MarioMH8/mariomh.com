---
import Box from '@mariomh/box/astro'
import Heading from '@mariomh/heading/astro'
import Span from '@mariomh/span/astro'
import { Image } from 'astro:assets'

import me from '../assets/me.png'
---

<section class='container w-full flex flex-row flex-wrap justify-center items-start gap-x-12'>
	<Heading size='h1' className='min-w-[380px] max-w-[680px] text-8xl mb-10 !leading-[1.3]' weight='medium'>
		<Span weight='light' family='secondary' size='xl' className='mb-10'>Hola, Soy Mario</Span><br />
		Desarrollo Apps <br/> y páginas web <br/> increíbles
	</Heading>
	<Box className='h-full w-[50%] min-w-[380px] max-w-[550px] aspect-[10/9] my-[5dvh] md:my-[10dvh] lg:my-[15dvh] pb-0' round='2xl'>
		<Image src={me} alt='Mario Menéndez Hidalgo' class='max-h-[100%] w-auto mx-auto scale-x-[-1]'/>
	</Box>
</section>
