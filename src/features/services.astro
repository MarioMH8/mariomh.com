---
import Box from '@mariomh/box/astro';
import Button from '@mariomh/button/astro';
import Container from '@mariomh/container/astro';
import Heading from '@mariomh/heading/astro';
import Paragraph from '@mariomh/paragraph/astro';
import Span from '@mariomh/span/astro';
import { getCollection } from 'astro:content';
import { Github } from 'lucide-astro';

const testimonials = await getCollection('testimonial');

const dotsClassName = (index: number) =>
	[
		'dot',
		'transition',
		'p-0 h-3 aspect-square',
		'rounded-full bg-primary-12 opacity-30',
		'hover:opacity-60 hover:bg-primary-12 hover:h-5',
		'focus:opacity-60 focus:bg-primary-12 focus:h-5 outline-primary-12',
		'active:opacity-80 active:bg-primary-12',
		'[&.active]:opacity-100 [&.active]:h-5',
		index === 0 ? 'active' : '',
	].join(' ');
---

<Container
	as='section'
	class='w-full pt-[5dvh] xl:pt-0 flex flex-col-reverse'>
	<div
		class='z-10 flex flex-col flex-nowrap gap-4 xl:flex-row justify-between items-center xl:items-end scroll-mt-4'
		id='servicios'>
		<div>
			<Heading
				className='m-0 dark:text-primary'
				dimension='xl'
				family='secondary'
				heading='h2'
				weight='light'>
				Servicios
			</Heading>
			<Paragraph
				className='leading-[1.3] mb-20 max-w-[550px] xl:max-w-[680px] text-balance'
				dimension='3xl'
				weight='medium'>
				Puedo ayudarte en muchas cosas, desde un portfolio con carácter hasta la tienda online que hará elevar
				tus ventas al siguiente nivel.
			</Paragraph>

			<Button
				as='a'
				class='hidden xl:inline-flex'
				href='https://github.com/MarioMH8'
				target='_blank'>
				<Github class='mr-6' />
				Visita mi GitHub
			</Button>
		</div>
		<div class='w-full xl:w-[50%]'>
			<Box
				className='p-0 mx-auto w-full xl:min-w-[380px] max-w-[550px] aspect-[10/12]'
				round='2xl'>
				<div class='carousel scrollbar-none overflow-x-hidden h-[85%]'>
					<div class='flex items-center h-full'>
						{
							testimonials.map(({ data }) => (
								<article class:list={['px-12', 'min-w-0 grow-0 shrink-0 basis-full']}>
									<Paragraph
										className='text-balance dark:text-primary-foreground'
										dimension='xl'>
										{data.content}
									</Paragraph>
									{data.author && (
										<Span
											className='block text-right italic dark:text-primary-foreground'
											weight='light'>
											— {data.author}
										</Span>
									)}
								</article>
							))
						}
					</div>
				</div>
				<div class='h-[15%] flex flex-row justify-center items-center'>
					{
						testimonials.map((_, index) => (
							<div class='flex flex-col justify-center items-center min-w-[2rem]'>
								<Button
									className={dotsClassName(index)}
									title={`Mostrar servicio ${index + 1}`}
								/>
							</div>
						))
					}
				</div>
			</Box>
		</div>
	</div>
	<svg
		class='z-0 translate-x-[35%] xl:-translate-x-[35%] scale-x-[-1] xl:scale-x-100 xl:translate-y-[35%]'
		fill='none'
		viewBox='0 0 1000 300'>
		<path
			class='stroke-primary-foreground dark:stroke-primary-background-element'
			d='m385.5606,197.06896c-12.18291,0 -22.0606,-9.83951 -22.0606,-21.97598l0,-92.02506c0,-12.13647 9.87768,-21.97598 22.0606,-21.97598l92.37871,0c0.47697,0 0.95079,0.01046 1.41939,0.04289l-0.05125,-0.04811c20.68733,0 20.68733,-20.60784 20.68733,-20.60784l0.05125,0.04811c-0.03033,-0.46651 -0.04602,-0.93929 -0.04602,-1.41102l0,-92.02506c0,-0.47697 0.01569,-0.94975 0.04602,-1.42148l-0.05125,0.04811c0.00209,-20.61307 -20.6842,-20.60784 -20.6842,-20.60784l0.03766,-0.03766l-0.57424,0.0272l-0.32321,0.01046l-0.51148,0.00523l-92.37871,0c-12.18291,0 -22.0606,-9.83951 -22.0606,-21.97598l0,-92.02506c0,-12.13647 9.87768,-21.97598 22.0606,-21.97598l92.37871,0c0.47906,0 0.95602,0.01046 1.42985,0.04289l-0.06171,-0.05857c20.68733,0 20.68733,-20.60784 20.68733,-20.60784l0.04811,0.04811c-0.02929,-0.46128 -0.04289,-0.92883 -0.04289,-1.40056l0,-92.02496c0,-12.13616 9.87821,-21.97608 22.0607,-21.97608l92.3786,0c12.18249,0 22.0607,9.83992 22.0607,21.97608l0,92.02496c0,12.13647 -9.87821,21.97598 -22.0607,21.97598l-92.3786,0l-0.6621,0c-0.24057,0.00523 -0.47697,0 -0.71963,-0.01569c-20.69256,-0.00523 -20.6842,20.60784 -20.6842,20.60784l-0.04079,-0.03766l0.03033,0.5847l0.01569,0.83678l0,92.02506c0,0.31066 -0.00837,0.61713 -0.02197,0.92255l-0.02406,0.48324l0.04079,-0.03766c0,20.60261 20.6842,20.60261 20.6842,20.60261l-0.05125,0.05334c0.47383,-0.03243 0.95079,-0.04811 1.43299,-0.04811l92.3786,0c12.18249,0 22.0607,9.83951 22.0607,21.97598l0,92.02506c0,12.13647 -9.87821,21.97598 -22.0607,21.97598l-92.3786,0l-0.72695,-0.01046l-0.65478,0.00523c-20.69256,-0.00523 -20.6842,20.60784 -20.6842,20.60784l-0.04079,-0.03766c0.03033,0.46651 0.04602,0.93929 0.04602,1.41102l0,92.02506c0,0.47697 -0.01569,0.94975 -0.04602,1.41625l0.04079,-0.03766c0,20.60261 20.6842,20.60261 20.6842,20.60261l-0.03975,0.03766c0.4686,-0.03243 0.94452,-0.04289 1.42148,-0.04289l92.3786,0c12.18249,0 22.0607,9.83951 22.0607,21.97598l0,405.81818c0,12.13647 -9.87821,21.97598 -22.0607,21.97598l-92.3786,0c-12.18249,0 -22.0607,-9.83951 -22.0607,-21.97598l0,-405.81818l0.0136,-0.72382l0.03243,-0.68721l-0.05125,0.04811c0.00209,-20.61307 -20.6842,-20.60784 -20.6842,-20.60784l0.05021,-0.04811c-0.46755,0.03243 -0.94452,0.04289 -1.42148,0.04289l-92.37871,0z'
			transform='rotate(90 500 150)'>
		</path>
	</svg>
</Container>

<script>
	import EmblaCarousel from 'embla-carousel';
	import type { EmblaOptionsType, EmblaPluginType } from 'embla-carousel';
	import Autoplay from 'embla-carousel-autoplay';

	const emblaNode = document.querySelector<HTMLDivElement>('.carousel');
	const options: EmblaOptionsType = { loop: true, slidesToScroll: 'auto' };
	const plugins: EmblaPluginType[] = [
		Autoplay({
			playOnInit: true,
			delay: 5000,
			stopOnFocusIn: true,
			stopOnInteraction: true,
			stopOnMouseEnter: true,
		}),
	];
	if (emblaNode) {
		const emblaApi = EmblaCarousel(emblaNode, options, plugins);

		const scrollTo = (index: number) => {
			emblaApi.scrollTo(index);
		};

		const dotNodes = Array.from(document.querySelectorAll('.dot'));
		dotNodes.forEach((dotNode, index) => {
			dotNode.addEventListener('click', () => scrollTo(index), false);
		});

		const toggleActive = () => {
			const previous = emblaApi.previousScrollSnap();
			const selected = emblaApi.selectedScrollSnap();
			dotNodes[previous]?.classList.remove('active');
			dotNodes[selected]?.classList.add('active');
		};

		emblaApi.on('init', toggleActive).on('reInit', toggleActive).on('select', toggleActive);
	}
</script>
