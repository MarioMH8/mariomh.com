---
import Button from '@mariomh/button/astro';
import Container from '@mariomh/container/astro';
import Heading from '@mariomh/heading/astro';
import Paragraph from '@mariomh/paragraph/astro';
---

<Container
	as='section'
	class='w-full flex flex-col gap-6 pt-[5dvh]'
	id='sobre-mi'>
	<Heading
		className='m-0 dark:text-primary'
		heading='h2'
		dimension='xl'
		family='secondary'
		weight='light'>
		Sobre mi
	</Heading>
	<Paragraph
		dimension='3xl'
		className='leading-[1.3] max-w-[640px] text-balance'
		weight='medium'>
		Soy un desarrollador apasionado <br class='hidden lg:block' />
		por la tecnología y la búsqueda <br class='hidden lg:block' />
		de soluciones a todo tipo de <br class='hidden lg:block' />
		proyectos desafiantes.
	</Paragraph>
	<Button
		as='a'
		className='w-fit cursor-pointer hidden-email'
		dimension='lg'
		data-email='holaATmariomhDOTcom'>
		Hablemos
	</Button>
</Container>
