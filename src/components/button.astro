---
import type { HTMLAttributes } from 'astro/types'
type Props = HTMLAttributes<'button'>;
// or extend with an `interface`
interface Props extends HTMLAttributes<'a'> {
	className?: string;
	openModal?: string;
	secondary?: boolean;
	link?: boolean;
	transparent?: boolean;
}

const { className, secondary, link, transparent, openModal, ...attrs } = Astro.props;
const cls = [secondary ? 'secondary' : transparent ? 'transparent' : link ? 'link' : ''];
cls.push(className);
const clsString = cls.filter(Boolean).join(' ')
---
<button class={clsString} data-trigger={openModal} {...attrs}>
	<slot/>
</button>

<style>
	button {
		background-color: var(--color-primary-300);
		color: var(--color-primary-500);
		padding: var(--size-base) var(--size-xl);
		border-radius: 12px;
		text-align: center;
	}

	button:has(svg) {
		display: flex;
		flex-flow: row;
		align-items: center;
		gap: var(--size-base);
	}

	button:focus,
	button:hover {
		outline: 2px solid var(--color-primary-300);
		outline-offset:3px;
	}
	button:active {
		opacity: .8;
	}

	button.secondary {
		color: var(--color-primary-200);
		background-color: var(--color-primary-600);
		outline-color: var(--color-primary-600);
		font-weight: var(--font-family-secondary);
	}

	button.transparent {
		color: var(--color-primary-300);
		background-color: transparent;
		border: 2px solid var(--color-primary-300);
	}
	button.transparent:hover {
		color: var(--color-primary-600);
		background-color: var(--color-primary-300);

	}

	button.link {
		color: var(--color-primary-500);
		background-color: transparent;
		border: none;
		outline: none;
	}
	button.link:hover {
		text-decoration: underline;

	}
</style>

