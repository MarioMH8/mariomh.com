---
const {title, className} = Astro.props;
const cls: string[] = [];
cls.push(className);
const clsString = cls.filter(Boolean).join(' ')
---
<button class={clsString} title={title}>
	<slot/>
</button>

<style>
	button {
		background-color: var(--color-primary-300);
		color: var(--color-primary-500);
		padding: var(--size-base) var(--size-xl);
		border-radius: 12px;
	}

	button:has(svg) {
		display: flex;
		flex-flow: row;
		align-items: center;
		gap: var(--size-base);
	}

	button:focus,
	button:hover {
		outline: 2px solid var(--color-primary-300);
		outline-offset:3px;
	}
	button:active {
		opacity: .8;
	}
</style>
