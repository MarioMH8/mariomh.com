---
const {title, className, secondary, transparent} = Astro.props;
const cls = [secondary ? 'secondary' : transparent ? 'transparent' : ''];
cls.push(className);
const clsString = cls.join(' ')
---
<button class={clsString} title={title}>
	<slot/>
</button>

<style>
	button {
		letter-spacing: 1px;
		background-color: var(--color-primary-300);
		color: var(--color-primary-600);
		padding: var(--size-base) var(--size-xl);
		border-radius: 12px;
		font-weight: 400;
		min-width: 150px;
	}

	button:has(svg) {
		display: flex;
		flex-flow: row;
		align-items: center;
		gap: var(--size-base);
	}

	button:focus,
	button:hover {
		outline: 2px solid var(--color-primary-300);
		outline-offset:3px;
	}
	button:active {
		opacity: .8;
	}

	button.secondary {
		color: var(--color-primary-200);
		background-color: var(--color-primary-600);
		outline-color: var(--color-primary-600);
		font-weight: var(--font-family-secondary);
	}

	button.transparent {
		color: var(--color-primary-300);
		background-color: transparent;
		border: 2px solid var(--color-primary-300);
	}
	button.transparent:hover {
		color: var(--color-primary-600);
		background-color: var(--color-primary-300);

	}
</style>
