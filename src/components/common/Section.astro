---
const { id, left, right, first } = Astro.props;
const position = left ? 'left' : right ? 'right' : '';
const isFirst = first ? 'first' : '';
const clz = [position, isFirst].join(' ');
---
<style>
	section {
		--section-left-padding: calc(var(--size-3xl) + clamp(0rem,-5rem + 16.66vw,15rem));
		--section-left-padding-mobile: calc(var(--size-2xl) + clamp(0rem,-5rem + 16.66vw,15rem));

		width: 100%;
		min-height: 100vh;
		position: relative;
		padding: var(--size-3xl);
		padding-left: var(--section-left-padding);

		display: flex;
		flex-direction: column;
		-webkit-box-pack: justify;
		justify-content: space-between;

		color: var(--color-white);
	}

	section:not(.first) {
		margin-top: 5vh;
	}

	section:not(.first):before {
		width: 100vw;
		max-width: 100%;
		height: calc(5vh + 1px);
		content: "";
		position: absolute;
		top: -5vh;
		left: 0;
		right: 0;
	}

	section.right::after,
	section.left::after {
		width: 100vw;
		max-width: 100%;
		height: calc(5vh + 1px);
		content: "";
		position: absolute;
		bottom: -5vh;
		left: 0;
		right: 0;
	}

	section.left::after {
		-webkit-clip-path: polygon(0 0, 100% 0, 100% 100%, 0 0%);
		clip-path: polygon(0 0, 100% 0, 100% 100%, 0 0%);
	}

	section.right::after {
		-webkit-clip-path: polygon(0 0, 100% 0, 100% 0%, 0 100%);
		clip-path: polygon(0 0, 100% 0, 100% 0%, 0 100%);
	}

	@media only screen and (max-width: 1400px) and (orientation: portrait) {
		section {
			padding: var(--size-2xl);
			padding-left: var(--section-left-padding-mobile);
			min-height: 75vh;
		}
	}
</style>


<section id={id} class={clz}>
	<slot/>
</section>
