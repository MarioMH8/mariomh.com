---
const { href } = Astro.props;
---
<style>
	.link {
		display: flex;
		-webkit-box-align: center;
		align-items: center;
		gap: var(--size-lg);
		max-width: calc(var(--size-base) * 10.2);
	}

	.link span {
		color: var(--color-accent-3);
		border: 1px solid var(--color-accent-3);
		border-radius: 50%;
		display: flex;
		-webkit-box-pack: center;
		justify-content: center;
		-webkit-box-align: center;
		align-items: center;
		min-height: var(--size-3xl);
		min-width: var(--size-3xl);
		padding: var(--size-xs);
		background-color: var(--color-white);
		transition: box-shadow,transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	.link:hover span {
		box-shadow: rgb(254 148 31 / 50%) 1px 1px 20px;
		transform: scale(1.1);
	}

	.link svg {
		height: var(--size-xl);
		width: var(--size-xl);
		fill: currentColor;
	}
</style>


<a class="link" href={href}>
	<span>
		<svg focusable="false" viewBox="0 0 24 24">
			<path
				d="M12 5.83L15.17 9l1.41-1.41L12 3 7.41 7.59 8.83 9 12 5.83zm0 12.34L8.83 15l-1.41 1.41L12 21l4.59-4.59L15.17 15 12 18.17z"></path>
		</svg>
	</span>
	Scroll down
</a>
