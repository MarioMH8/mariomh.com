---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'section'> {

}

const { class: className, ...attrs} = Astro.props;
---

<section class:list={['container', className]} {...attrs}>
	<slot/>
</section>

<style>
	.container {
		flex-basis: 100%;
		width: 100%;
		margin-bottom: calc(var(--size-4xl) * 1.75);
	}
</style>
