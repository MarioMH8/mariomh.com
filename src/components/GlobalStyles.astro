        --font-family-primary: Poppins, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";

		--size-xs: clamp(0.56rem, 0.15vw + 0.52rem, 0.7rem);
		--size-sm: clamp(0.7rem, 0.25vw + 0.64rem, 0.94rem);
		--size-base: clamp(0.88rem, 0.39vw + 0.78rem, 1.25rem);
		--size-lg: clamp(1.09rem, 0.6vw + 0.94rem, 1.67rem);
		--size-xl: clamp(1.37rem, 0.9vw + 1.14rem, 2.22rem);
		--size-2xl: clamp(1.71rem, 1.32vw + 1.38rem, 2.96rem);
		--size-3xl: clamp(2.14rem, 1.91vw + 1.66rem, 3.95rem);
		--size-4xl: clamp(2.67rem, 2.73vw + 1.99rem, 5.26rem);

        --font-weight-lightest: 100;
