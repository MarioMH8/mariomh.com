<style>
    .hero {
        width: 100%;
        height: 110vh;
        background-color: cadetblue;
        -webkit-clip-path: polygon(0 0, 100% 0, 100% 94%, 0 100%);
        clip-path: polygon(0 0, 100% 0, 100% 94%, 0 100%);
        position: relative;
        z-index: 20;
        text-align: center;
    }
    figcaption {
        left: 50%;
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
    }

    h1 {
        font-size: 32px;
    }

    p {
        font-size: 14px;
        font-weight: 300;
        margin-top: 0.5em;
    }
</style>

<div class="hero">
    <figcaption>
        <h1>Angled Edge</h1>
        <p>Image with CSS clip-path</p>
    </figcaption>
</div>
