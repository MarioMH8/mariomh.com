---
import Section from './common/Section.astro'
---
<style>
	:global(#about) {
		z-index: 4;
	}

	:global(#about),
	:global(#about):after,
	:global(#about):before {
		background-color: cornflowerblue;
	}

	.content {
		width: 100%;
	}

	@media only screen and (min-width: 630px) {
		.content {
			width: 85%;
		}
	}

	@media only screen and (min-width: 850px) {
		.content {
			width: 70%;
		}
	}

	@media only screen and (min-width: 1200px) {
		.content {
			width: 55%;
		}
	}
</style>

<Section id="about" left>
	<h1 class="title word"># Sobre m<span class="i color-accent-3">i</span></h1>
	<p class="content">
		Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam lobortis vulputate nibh, sit amet vehicula dolor rutrum vitae. Aliquam volutpat lacus id dolor imperdiet bibendum.
	</p>
	<div/>
</Section>
