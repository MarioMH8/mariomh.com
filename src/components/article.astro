---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {

}

const { title, ...attrs } = Astro.props;
---

<article {...attrs}>
	<header>
		<h2 class="text-lg font-secondary">{title}</h2>
	</header>
	<slot/>
</article>

<style>
	article {
		min-height: max(50svh, 40vmax);

		background-color: var(--color-primary-200);
		border-radius: var(--size-xl);
		padding: var(--size-3xl);

		position: relative;
	}

	header {
		margin-bottom: var(--size-xl);
	}
	article:after {
		content: '';
		position: absolute;
		width: 200px;
		right: -132px;
		top: -132px;
		aspect-ratio: 1;
		color: var(--color-primary-200);
		background-image: url("/svg/forma01-esquina.svg");
		background-repeat: no-repeat;
	}
</style>
