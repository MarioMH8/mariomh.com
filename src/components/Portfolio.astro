<style>
    section {
        width: 100%;
        height: 106vh;
        position: relative;

		color: var(--color-white);
        background-color: darkslateblue;

        z-index: 20;
        padding: 4rem;
        padding-top: calc(4rem + 5vh + 1px);
    }

    section::after {
		width: 100vw;
		height: calc(5vh + 1px);
		background-color: darkslateblue;
        content: "";
        margin-left: -4rem;
	    position: absolute;
	    bottom: -5vh;
        -webkit-clip-path: polygon(0 0, 100% 0, 100% 0%, 0 100%);
        clip-path: polygon(0 0, 100% 0, 100% 0%, 0 100%);
    }

    @media only screen and (max-width: 1400px) {
        section {
            padding: 1.5rem;
            padding-top: calc(1.5rem + 5vh + 1px);
        }

        section::after {
            margin-left: -1.5rem;
        }
    }

    #portfolio {
        position: absolute;
        top: 5vh;
    }
</style>

<section>
	<span id="portfolio"/>
</section>
