---
import Section from './common/Section.astro'
import Dot from './common/Dot.astro'
import ScrollButton from './common/ScrollButton.astro'
---
<style>
	:global(#index) {
		z-index: 5;
	}

	:global(#index),
	:global(#index):after,
	:global(#index):before {
		background-color: var(--color-primary);
	}

	.introduction {
		width: 100%;
	}

	@media only screen and (min-width: 630px) {
		.introduction {
			width: 85%;
		}
	}

	@media only screen and (min-width: 850px) {
		.introduction {
			width: 70%;
		}
	}

	@media only screen and (min-width: 1200px) {
		.introduction {
			width: 55%;
		}
	}

</style>

<Section id="index" right first>
	<div/>
	<div class="introduction">
		<h1 class="title">Soy
			<span class="word">Mar<span class="i color-accent-1">i</span>o</span>
			<span class="word">Men<span class="e color-accent-2">&eacute;</span>ndez</span>
			<span class="word">H<span class="i color-accent-3">i</span>dalgo</span>
		</h1>
		<h2 class="content">Desarrollador Full Stack <Dot/> Amante de JavaScript</h2>
	</div>
	<div>
		<ScrollButton href="#about"/>
	</div>
</Section>
