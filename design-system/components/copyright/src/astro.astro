---
import type { AstroCopyrightProperties } from './astro';
import ELEMENT_TYPE from './element.ts';
import properties from './properties.ts';

export interface Props extends AstroCopyrightProperties {}

const { from = `${new Date().getFullYear()}`, to } = Astro.props;

const { as: Tag = ELEMENT_TYPE, ...p } = properties(Astro.props);

const join = [from, to].filter(Boolean).join(' - ');
---

<Tag {...p}>
	© {join} Mario Menéndez Hidalgo
</Tag>
