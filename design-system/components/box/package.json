{
	"name": "@mariomh/box",
	"version": "0.0.0",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "MarioMH box",
	"keywords": [
		"design",
		"design system",
		"ui"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/mariomh.com.git",
		"directory": "design-system/components/box"
	},
	"homepage": "https://github.com/MarioMH8/mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/mariomh.com/issues"
	},
	"license": "PRIVATE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./astro": {
			"types": "./dist/astro.ts",
			"default": "./dist/astro.ts"
		},
		"./class-name": {
			"types": "./dist/class-name.d.ts",
			"default": "./dist/class-name.js"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./properties": {
			"types": "./dist/properties.d.ts",
			"default": "./dist/properties.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		},
		"./variants": {
			"types": "./dist/variants.d.ts",
			"default": "./dist/variants.js"
		}
	},
	"typesVersions": {
		"*": {
			"./astro": [
				"./dist/astro.ts"
			],
			"./class-name": [
				"./dist/class-name.d.ts"
			],
			"./properties": [
				"./dist/properties.d.ts"
			],
			"./react": [
				"./dist/react.d.ts"
			],
			"./variants": [
				"./dist/variants.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsup",
		"lint:packages": "publint",
		"prepublishOnly": "tsup && publint"
	},
	"peerDependencies": {
		"@mariomh/round": "0.0.0",
		"@mariomh/shadow": "0.0.0",
		"@radix-ui/react-slot": "^1",
		"astro": "^5",
		"react": "^19"
	},
	"peerDependenciesMeta": {
		"@mariomh/round": {
			"optional": true
		},
		"@mariomh/shadow": {
			"optional": true
		},
		"@radix-ui/react-slot": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"dependencies": {
		"@mariomh/cva": "0.0.0"
	},
	"devDependencies": {
		"@mariomh/round": "0.0.0",
		"@mariomh/shadow": "0.0.0",
		"@radix-ui/react-slot": "1.1.1",
		"@testing-library/react": "16.1.0",
		"astro": "5.1.1",
		"react": "19.0.0",
		"tsup": "8.3.5"
	}
}
