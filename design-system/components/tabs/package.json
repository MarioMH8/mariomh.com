{
	"name": "@mariomh/tabs",
	"version": "0.0.0",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "MarioMH tabs",
	"keywords": [
		"design",
		"design system",
		"ui"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/mariomh.com.git",
		"directory": "design-system/components/tabs"
	},
	"homepage": "https://github.com/MarioMH8/mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/mariomh.com/issues"
	},
	"license": "PRIVATE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./class-name": {
			"types": "./dist/class-name.d.ts",
			"default": "./dist/class-name.js"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./properties": {
			"types": "./dist/properties.d.ts",
			"default": "./dist/properties.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		},
		"./variants": {
			"types": "./dist/variants.d.ts",
			"default": "./dist/variants.js"
		}
	},
	"typesVersions": {
		"*": {
			"./class-name": [
				"./dist/class-name.d.ts"
			],
			"./properties": [
				"./dist/properties.d.ts"
			],
			"./react": [
				"./dist/react.d.ts"
			],
			"./variants": [
				"./dist/variants.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsup",
		"lint:packages": "publint",
		"prepublishOnly": "tsup && publint"
	},
	"peerDependencies": {
		"@radix-ui/react-slot": "^1",
		"@radix-ui/react-tabs": "^1",
		"react": "^19"
	},
	"peerDependenciesMeta": {
		"@radix-ui/react-slot": {
			"optional": true
		},
		"@radix-ui/react-tabs": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"dependencies": {
		"@mariomh/cva": "0.0.0"
	},
	"devDependencies": {
		"@radix-ui/react-slot": "1.1.1",
		"@radix-ui/react-tabs": "1.1.2",
		"@testing-library/react": "16.1.0",
		"react": "19.0.0",
		"tsup": "8.3.5"
	}
}
