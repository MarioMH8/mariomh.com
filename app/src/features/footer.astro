---
import { SOCIAL_ICONS } from '@app/features/icons';
import cv from '@cv';
import Button from '@mariomh/button/astro';
import Copyright from '@mariomh/copyright/astro';
---

<footer
	class='bg-primary-dark-background dark:bg-primary-background w-full pt-[5dvh] pb-[10dvh] flex flex-col gap-[5dvh] justify-center items-center'>
	<div class='flex flex-row gap-8 items-center'>
		{
			cv.basics.profiles.map(profile => {
				const Icon = SOCIAL_ICONS[profile.network];

				if (!Icon) {
					return <> </>;
				}

				return (
					<Button
						as='a'
						class='ring-offset-primary-dark-background dark:ring-offset-primary-background'
						href={profile.url ?? ''}
						icon
						target='_blank'
						variant='solid'>
						<Icon
							height='24'
							width='24'
						/>
						<span class='sr-only'>{profile.network}</span>
					</Button>
				);
			})
		}
	</div>
	<Copyright
		className='text-primary-dark-foreground dark:text-primary-foreground'
		from='2022'
		to={new Date().getFullYear()}
	/>
</footer>
