---
import Heading from '@mariomh/heading/astro';

const { className, title } = Astro.props;
---

<section class:list={['flex flex-col gap-4 print:gap-0', className]}>
	{
		title && (
			<Heading
				class='relative w-full text-2xl print:text-xl mb-0 flex items-center gap-3 print:gap-1'
				heading='h3'
				weight='medium'>
				{title}
			</Heading>
		)
	}
	<slot />
</section>
