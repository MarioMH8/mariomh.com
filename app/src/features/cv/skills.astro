---
import Section from '@app/features/cv/section.astro';
import { SKILLS_ICONS } from '@app/features/icons';
import { skills } from '@cv';
---

<Section
	className='print:hidden'
	title='Tecnologías'>
	<ul class='inline-flex flex-wrap gap-6'>
		{
			skills.map(({ name }) => {
				const Icon = SKILLS_ICONS[name];

				return (
					<li
						class:list={[
							'text-sm',
							'rounded-md px-2 py-0.5',
							'text-primary-foreground-highlight',
							'bg-primary-background-subtle/40 dark:bg-primary-dark-background-subtle',
							'border border-primary-border dark:border-primary-dark-border',
							'flex gap-2 items-center flex-row',
						]}>
						{Icon && <Icon class='size-5' />}
						<span>{name}</span>
					</li>
				);
			})
		}
	</ul>
</Section>
