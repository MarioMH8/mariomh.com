---
import { ArrowIcon, GitIcon } from '@app/features/icons';
import cv from '@cv';
import Paragraph from '@mariomh/paragraph/astro';
import { Folder } from 'lucide-astro';

type Project = (typeof cv.projects)[number];

interface Props {
	project: Project;
}
const { project } = Astro.props;
const { description, github, highlights, isActive, name, url } = project;
---

<article
	class:list={[
		'relative flex flex-col',
		'grid-span-1',
		'shadow-sm',
		'bg-primary-background-subtle/20 dark:bg-primary-dark-background-subtle/20',
		'ring ring-primary-foreground/10 dark:ring-primary-dark-foreground/10',
		'rounded-md bg-skin-button-muted/50 p-5',
	]}>
	<header class='flex items-center justify-between space-x-2'>
		<div class='flex items-center gap-2'>
			<Folder
				aria-hidden='true'
				class='size-4'
			/>
			{
				isActive ? (
					<a
						class:list={[
							'group',
							'font-primary',
							'hover:text-primary-foreground-highlight dark:hover:text-primary',
							'flex items-center gap-2',
							'decoration-dotted underline-offset-5 hover:underline',
						]}
						href={url}
						target='_blank'
						title={`Ver ${name}`}>
						{name}
						<ArrowIcon
							aria-hidden='true'
							class:list={[
								'size-4',
								'transition motion-reduce:transition-none ease-linear',
								'group-hover:-translate-y-0.5 group-hover:translate-x-0.5',
							]}
						/>
					</a>
				) : (
					<span>{name}</span>
				)
			}
		</div>
		{
			github && (
				<a
					class='opacity-75 hover:opacity-100 transition-opacity motion-reduce:transition-none ease-linear'
					href={github}
					rel='noopener'
					target='_blank'
					title='Ver el repositorio de códifo'>
					<GitIcon class='size-4' />
				</a>
			)
		}
	</header>
	<Paragraph
		class='my-2'
		dimension='sm'>
		{description}
	</Paragraph>
	<ul
		class:list={[
			'text-sm text-primary-foreground/65 dark:text-primary-dark-foreground/65',
			'list-disc space-y-1',
			'ml-4',
		]}>
		{
			highlights.map(highlight => {
				return <li>{highlight}</li>;
			})
		}
	</ul>
</article>
