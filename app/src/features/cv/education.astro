---
import Section from '@app/features/cv/section.astro';
import { certificates, education } from '@cv';
import Heading from '@mariomh/heading/astro';
import Span from '@mariomh/span/astro';
import { GraduationCap, ScrollText } from 'lucide-astro';

import { ArrowIcon } from '../icons';
---

<Section
	className='order-first'
	title='Educación'>
	<ul class='pt-2 pb-4 space-y-4 print:space-y-3'>
		{
			education.map(({ area, endDate, institution, startDate, url }) => {
				const startYear = new Date(startDate).getFullYear();
				const endYear = endDate === undefined ? 'Presente' : new Date(endDate).getFullYear();
				const years = `${startYear} - ${endYear}`;

				return (
					<div class='flex gap-4'>
						<GraduationCap class='size-5 self-start hidden md:inline-block print:hidden' />
						<div class='relative w-full flex flex-col justify-between'>
							{url ? (
								<a
									class:list={[
										'group',
										'w-fit',
										'font-primary',
										'hover:text-primary-foreground-highlight dark:hover:text-primary',
										'flex items-center gap-2',
										'decoration-dotted underline-offset-5 hover:underline',
									]}
									href={url}
									target='_blank'
									title={`Ver ${institution}`}>
									{institution}
									<ArrowIcon
										aria-hidden='true'
										class:list={[
											'size-4',
											'print:hidden',
											'transition motion-reduce:transition-none ease-linear',
											'group-hover:-translate-y-0.5 group-hover:translate-x-0.5',
										]}
									/>
								</a>
							) : (
								<span class='block'>{institution}</span>
							)}
							<Span
								class='block'
								dimension='sm'
								variant='muted'>
								{area}
							</Span>
							<Span
								as='time'
								class='right-0 top-0 md:absolute md:block print:text-xs print:order-first'
								dimension='sm'
								variant='muted'>
								{years}
							</Span>
						</div>
					</div>
				);
			})
		}
	</ul>
	{
		certificates && (
			<>
				<Heading
					class='relative w-full text-lg mb-0 flex items-center gap-3 print:gap-1'
					heading='h4'
					weight='medium'>
					Certificados
				</Heading>
				<ul class='pt-2 pb-4 space-y-4 print:space-y-3'>
					{certificates.map(({ date, issuer, name, url }) => {
						const certificateYear = new Date(date).getFullYear();

						return (
							<div class='flex gap-4'>
								<ScrollText class='size-5 self-start hidden md:inline-block print:hidden' />
								<div class='relative w-full flex flex-col justify-between'>
									{url ? (
										<a
											class:list={[
												'group',
												'w-fit',
												'font-primary',
												'hover:text-primary-foreground-highlight dark:hover:text-primary',
												'flex items-center gap-2',
												'decoration-dotted underline-offset-5 hover:underline',
											]}
											href={url}
											target='_blank'
											title={`Ver ${name}`}>
											{name}
											<ArrowIcon
												aria-hidden='true'
												class:list={[
													'size-4',
													'print:hidden',
													'transition motion-reduce:transition-none ease-linear',
													'group-hover:-translate-y-0.5 group-hover:translate-x-0.5',
												]}
											/>
										</a>
									) : (
										<span class='block'>{name}</span>
									)}
									<Span
										class='block'
										dimension='sm'
										variant='muted'>
										{issuer}
									</Span>
									<Span
										as='time'
										class='right-0 top-0 md:absolute md:block print:text-xs print:order-first'
										dimension='sm'
										variant='muted'>
										{certificateYear}
									</Span>
								</div>
							</div>
						);
					})}
				</ul>
			</>
		)
	}
</Section>
