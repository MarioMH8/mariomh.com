---
import BlogPreview from '@app/features/blog-preview.astro';
import Button from '@mariomh/button/astro';
import Heading from '@mariomh/heading/astro';
import { getCollection } from 'astro:content';

let posts = await getCollection('post');

posts = posts
	.sort((b, a) => a.id.localeCompare(b.id))
	.slice(0, 6);
---

<section
	class:list={[
		'container w-full pt-[5dvh] md:pt-[10dvh] lg:pt-[15dvh]',
		'flex flex-col md:flex-row justify-between gap-12',
	]}
	id='blog-recent'>
	<div class='w-full md:w-[30%]'>
		<Heading
			className='text-xl dark:text-primary'
			heading='h2'
			weight='light'>
			Blog
		</Heading>
		<Heading
			className='text-6xl leading-6xl mb-12'
			heading='h3'
			weight='medium'>
			Artículos <br class='hidden lg:block' /> recientes
		</Heading>

		<Button
			as='a'
			href='/blog'
			title='Blog de MarioMH'>
			Ver más
		</Button>
	</div>
	<div
		class:list={[
			'px-4 md:px-12 pt-12 pb-10',
			'w-full md:w-[70%] pb-6 flex flex-row gap-12',
			'overflow-x-auto overflow-y-hidden',
		]}>
		{posts.map(post => <BlogPreview post={post} />)}
	</div>
</section>
