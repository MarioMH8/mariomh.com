---
import cv from '@cv';
import Button from '@mariomh/button/astro';
import { NavigationMenu as Nav, NavigationMenuLI, NavigationMenuLink } from '@mariomh/navigation-menu/astro';

interface Props {
	blog?: boolean;
}

const { blog } = Astro.props;
---

<Nav>
	<NavigationMenuLI>
		<NavigationMenuLink
			className='font-secondary'
			href='/#sobre-mi'>
			Sobre mi
		</NavigationMenuLink>
	</NavigationMenuLI>
	<NavigationMenuLI>
		<NavigationMenuLink
			className='font-secondary'
			href='/#portfolio'>
			Portfolio
		</NavigationMenuLink>
	</NavigationMenuLI>
	<NavigationMenuLI>
		<NavigationMenuLink
			className='font-secondary'
			href='/#servicios'>
			Servicios
		</NavigationMenuLink>
	</NavigationMenuLI>
	<NavigationMenuLI>
		<NavigationMenuLink
			active={blog === true}
			className='font-secondary'
			href='/blog'>
			Blog
		</NavigationMenuLink>
	</NavigationMenuLI>
	<NavigationMenuLI>
		<Button
			as='a'
			href={`mailto:${cv.basics.email}`}
			variant='solid'>
			Contáctame
		</Button>
	</NavigationMenuLI>
</Nav>
