---
import About from '@app/features/cv/about.astro';
import Experience from '@app/features/cv/experience.astro';
import Hero from '@app/features/cv/hero.astro';
import Projects from '@app/features/cv/projects.astro';
import Skills from '@app/features/cv/skills.astro';
import Layout from '@app/layouts/layout.astro';

import Education from '../features/cv/education.astro';
---

<Layout
	className='bg-cv-background dark:bg-cv-dark-background'
	nav={false}>
	<main
		class:list={[
			'relative container print:px-8 print:py-4',
			'max-w-7xl print:max-w-none',
			'max-lg:py-16 xl:p-16',
			'grid',
			'xl:grid-cols-6 print:grid-cols-1',
			'gap-12 xl:gap-24 print:gap-6',
		]}>
		<div
			class:list={[
				'space-y-6 xl:col-span-2',
				'print:col-span-1 print:grid print:grid-cols-2 print:gap-3 print:space-y-0',
				'max-xl:max-w-180 max-xl:mx-auto',
			]}>
			<Hero />
			<About />
		</div>
		<div
			class:list={[
				'space-y-12 xl:col-span-4',
				'print:col-span-1 print:grid print:grid-cols-4 print:gap-2 print:space-y-0',
			]}>
			<Experience />
			<Projects />
			<Skills />
			<Education />
		</div>
	</main>
</Layout>

<style>
	@page {
		size: auto;
		margin: 0;
	}
</style>
