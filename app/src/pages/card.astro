---
import 'atropos/css';

import Layout from '@app/layouts/layout.astro';
import Logo from '@mariomh/logo/astro';
import Span from '@mariomh/span/astro';
---

<Layout nav={false}>
	<main class='container w-full h-[100dvh] flex flex-row justify-center items-center'>
		<div class='atropos card aspect-[20/11] w-full max-w-200'>
			<div class='atropos-scale'>
				<div class='atropos-rotate'>
					<div class='atropos-inner bg-primary rounded-lg p-[5%] !flex flex-col justify-between'>
						<Logo
							class='w-fit hidden sm:flex'
							dimension='sm'
							isotipo='dark'
							logotipo='dark'
						/>
						<Logo
							class='w-fit flex sm:hidden'
							dimension='xs'
							isotipo='dark'
							logotipo='dark'
						/>
						<p class='pl-[20%] hidden sm:block'>
							<Span
								as='a'
								class='block dark:text-primary-foreground'
								dimension='xl'
								href='mailto:hola@mariomh.com'>
								hola@mariomh.com
							</Span>
							<Span
								as='a'
								class='block dark:text-primary-foreground'
								dimension='xl'
								href='https://mariomh.com'>
								mariomh.com
							</Span>
						</p>
						<p class='pl-[20%] block sm:hidden'>
							<Span
								as='a'
								class='block dark:text-primary-foreground'
								dimension='lg'
								href='mailto:hola@mariomh.com'>
								hola@mariomh.com
							</Span>
							<Span
								as='a'
								class='block dark:text-primary-foreground'
								dimension='lg'
								href='https://mariomh.com'>
								mariomh.com
							</Span>
						</p>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	import Atropos from 'atropos';

	Atropos({
		alwaysActive: true,
		el: '.card',
	});
</script>
