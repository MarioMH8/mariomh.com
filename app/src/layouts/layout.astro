---
import '@mariomh/archia/100.css';
import '@mariomh/archia/300.css';
import '@mariomh/archia/400.css';
import '@mariomh/archia/500.css';
import '@mariomh/archia/600.css';
import '@mariomh/archia/700.css';
import '@fontsource/dm-sans/100.css';
import '@fontsource/dm-sans/200.css';
import '@fontsource/dm-sans/300.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/dm-sans/800.css';
import '@fontsource/dm-sans/900.css';

import './layout.css';


import { ClientRouter } from 'astro:transitions';
import { SEO } from 'astro-seo';
import cv from '../../cv.json'

import NavigationMenu from '../features/navigation-menu.astro';

interface Props {
	title?: string;
	description?: string;
}

const { description, title } = Astro.props;
const computedTitle = title ? `${title} - ${cv.basics.name}` : `${cv.basics.name} - ${cv.basics.label}`;
const computedDescription =
	description ??
	cv.basics.summary;
---

<!doctype html>
<html lang='es'>
	<head>
		<meta charset='utf8' />
		<meta
			content='width=device-width'
			name='viewport'
		/>

		<SEO
			description={computedDescription}
			openGraph={{
				basic: {
					image: '/og.webp',
					title: `${cv.basics.name} - ${cv.basics.label}`,
					type: 'website',
				},
			}}
			title={computedTitle}
		/>

		<meta
			content='#0F1214'
			name='theme-color'
		/>
		<meta
			content={Astro.generator}
			name='generator'
		/>

		<link
			href='/sitemap-index.xml'
			rel='sitemap'
		/>

		<ClientRouter />
		<script is:inline>
			function getSystemTheme() {
				return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}

			function getThemePreference() {
				const localItem = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
				if (localItem === 'dark' || localItem === 'light') {
					return localItem;
				}

				return getSystemTheme();
			}

			function toggleTheme() {
				const element = document.documentElement;
				const isDark = getThemePreference() === 'dark';
				const hasDark = element.classList.contains('dark');
				if (isDark !== hasDark) {
					element.classList.toggle('dark', isDark);
				}
				const hasDarkScrollbar = element.classList.contains('scrollbar-track-primary-dark-background');
				if (isDark !== hasDarkScrollbar) {
					element.classList.toggle('scrollbar-track-primary-dark-background', isDark);
				}
			}

			document.addEventListener('astro:page-load', () => {
				toggleTheme();
			});

			toggleTheme();
		</script>
	</head>
	<body>
		<NavigationMenu />
		<main>
			<slot />
		</main>
	</body>
</html>
